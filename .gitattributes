# Default: enforce LF for all autodetected text files
* text=auto eol=lf
# Enforce LF line endings for build-critical files
*.sh          text eol=lf
Dockerfile    text eol=lf
**/Dockerfile text eol=lf
Makefile      text eol=lf
*.mk          text eol=lf
*.py          text eol=lf

# Documentation (safe)
*.md          text eol=lf
*.txt         text eol=lf

# Binary artifacts
*.bin         binary
*.elf         binary
*.o           binary
*.a           binary
